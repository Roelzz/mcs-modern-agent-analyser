# Environment: "dev" or "prod"
REFLEX_ENV=dev

# Dev ports (only used when REFLEX_ENV=dev)
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Prod port (only used when REFLEX_ENV=prod, single-port mode)
PORT=2009

# App settings
LOG_LEVEL=INFO
PYTHONUTF8=1

# Optional: comma-separated Dataverse hostname suffixes for sovereign clouds.
# Defaults: .dynamics.com,.microsoftdynamics.de,.dynamics.cn,.crm.appsplatform.us
# DATAVERSE_ALLOWED_HOST_SUFFIXES=.example.sovereign-cloud
